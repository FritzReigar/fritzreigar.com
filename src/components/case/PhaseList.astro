---
// Las fases de una ficha (plan/spec-visual.md § 2.2, «Fichas»): un <ol> en 3 columnas, cada fase
// con el filete fuerte de 2 px arriba, su número cobalto a --text-step (el contador del <ol>), el
// título y el texto en gris. 2 columnas por debajo de 60rem y 1 a 35rem o menos; «Hoy sigue en
// mantenimiento.» debajo, en negrita.
interface Props {
  items: readonly { title: string; text: string }[];
  today?: string;
}

const { items, today } = Astro.props;
---
<ol class="phase-list">
  {items.map((phase) => (
    <li>
      <h3>{phase.title}</h3>
      <p>{phase.text}</p>
    </li>
  ))}
</ol>
{today && <p class="phase-list__today">{today}</p>}

<style>
  .phase-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap-col);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: phase;
  }

  li {
    padding-block: var(--space-3) var(--space-5);
    border-top: var(--rule-mid) solid var(--color-line-strong);
    counter-increment: phase;
  }

  li::before {
    content: counter(phase);
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-accent);
    font-size: var(--text-step);
    font-weight: var(--weight-poster);
    font-stretch: var(--stretch-poster);
    line-height: var(--leading-card);
  }

  h3 {
    margin-bottom: var(--space-1);
    font-size: var(--text-h4);
    font-weight: var(--weight-poster);
  }

  li p {
    color: var(--color-text-muted);
    font-size: var(--text-s);
  }

  .phase-list__today {
    margin-top: var(--space-1);
    font-weight: var(--weight-bold);
  }

  @media (max-width: 60rem) {
    .phase-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 35rem) {
    .phase-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
