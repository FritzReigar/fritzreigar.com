---
// El cuerpo de una ficha (decisión F1 de plan/fase-2.md): pinta las piezas que trae su JSON, en
// este orden fijo, sea cual sea el del JSON: PullQuote → Prose → BeforeAfter → FeatureRows →
// FigureList → PhaseList → LayerStack → CaseClosing (plan/spec-visual.md § 2.2, «Fichas», y
// § 3.4). Cada pieza con título es una sección con su cartel (SectionTitle); la cita y el cierre
// llevan el suyo propio. LayerStack (Snugtone) llega en la 2.6: hasta entonces, sin estilo.
import type { CaseEntry } from '../../data/cases';
import type { Lang } from '../../data/ui';
import SectionTitle from '../ui/SectionTitle.astro';
import BeforeAfter from './BeforeAfter.astro';
import CaseClosing from './CaseClosing.astro';
import FeatureRows from './FeatureRows.astro';
import FigureList from './FigureList.astro';
import PhaseList from './PhaseList.astro';
import Prose from './Prose.astro';
import PullQuote from './PullQuote.astro';

interface Props {
  body: CaseEntry['data']['body'];
  lang: Lang;
}

const { body, lang } = Astro.props;
const { pullQuote, prose, beforeAfter, featureRows, figureList, phaseList, layerStack, caseClosing } =
  body;

// El id de cada sección, de su título: «Qué hice, por fases» → que-hice-por-fases.
const idOf = (title: string): string =>
  title
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---
{pullQuote && <PullQuote id={idOf(pullQuote.label)} label={pullQuote.label} text={pullQuote.text} />}

{prose && (
  <section class="section" aria-labelledby={idOf(prose.title)}>
    <div class="wrap">
      <SectionTitle id={idOf(prose.title)} text={prose.title} />
      <Prose intro={prose.intro} items={prose.items} outro={prose.outro} />
    </div>
  </section>
)}

{beforeAfter && (
  <section class="section" aria-labelledby={idOf(beforeAfter.title)}>
    <div class="wrap">
      <SectionTitle id={idOf(beforeAfter.title)} text={beforeAfter.title} />
      <BeforeAfter note={beforeAfter.note} pairs={beforeAfter.pairs} lang={lang} />
    </div>
  </section>
)}

{featureRows && (
  <section class="section" aria-labelledby={featureRows.title && idOf(featureRows.title)}>
    <div class="wrap">
      {featureRows.title && <SectionTitle id={idOf(featureRows.title)} text={featureRows.title} />}
      <FeatureRows items={featureRows.items} />
    </div>
  </section>
)}

{figureList && (
  <section class="section" aria-labelledby={idOf(figureList.title)}>
    <div class="wrap">
      <SectionTitle id={idOf(figureList.title)} text={figureList.title} />
      <FigureList note={figureList.note} items={figureList.items} />
    </div>
  </section>
)}

{phaseList && (
  <section class="section" aria-labelledby={idOf(phaseList.title)}>
    <div class="wrap">
      <SectionTitle id={idOf(phaseList.title)} text={phaseList.title} />
      <PhaseList items={phaseList.items} today={phaseList.today} />
    </div>
  </section>
)}

{layerStack && (
  <section class="section" aria-labelledby={idOf(layerStack.title)}>
    <div class="wrap">
      <SectionTitle id={idOf(layerStack.title)} text={layerStack.title} />
      <p class="lede">{layerStack.lede}</p>
      {layerStack.layers && (
        <ol>
          {layerStack.layers.map((layer) => <li><strong>{layer.name}</strong> {layer.text}</li>)}
        </ol>
      )}
    </div>
  </section>
)}

{caseClosing && <CaseClosing columns={caseClosing.columns} />}
