---
// El cierre de una ficha (plan/spec-visual.md § 2.2, «Fichas»): columnas con su título en caja
// alta bajo la regla cobalto de 6 px, y en cada una su texto, sus etiquetas de tecnología
// (StackList) o su acción. Tres columnas en las de Trabajo; 1 columna por debajo de 60rem. Es la
// última sección de la página: cierra con --space-end. Las dos columnas de Snugtone y su Button
// de descarga, en la 2.6.
import type { Rich as RichText } from '../../data/rich';
import Button from '../ui/Button.astro';
import Rich from '../ui/Rich.astro';
import StackList from '../ui/StackList.astro';

interface Props {
  columns: readonly {
    title: string;
    text?: RichText;
    stack?: readonly string[];
    action?: { text: string; href: string };
  }[];
}

const { columns } = Astro.props;
---
<div class="section section--last">
  <div class="wrap case-closing">
    {columns.map((column) => (
      <section>
        <h2>{column.title}</h2>
        {column.text && <p><Rich text={column.text} /></p>}
        {column.stack && <StackList items={column.stack} />}
        {column.action && <Button href={column.action.href} variant="primary" external class="case-closing__action">{column.action.text}</Button>}
      </section>
    ))}
  </div>
</div>

<style>
  .case-closing {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5) var(--gap-wide);
  }

  h2 {
    margin-bottom: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--rule-thick) solid var(--color-accent);
    font-size: var(--text-h3);
    font-weight: var(--weight-poster);
    font-stretch: var(--stretch-poster);
    text-transform: uppercase;
  }

  .case-closing :global(.case-closing__action) {
    margin-top: var(--space-4);
  }

  @media (max-width: 60rem) {
    .case-closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
