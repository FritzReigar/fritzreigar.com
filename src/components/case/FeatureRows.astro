---
// Una fila por función o por punto (plan/spec-visual.md § 2.2, «Fichas»): el filete fuerte de 2 px
// arriba, el título en caja alta a --text-principle (1-3) y el texto (4-7). Apiladas por debajo de
// 60rem. Hoy, sin capturas: «Qué se hizo» de Artemisa (spec § 2.4) y los puntos de Snugport. La
// captura de cada fila (8-12, Snugtone) llega en la 2.6.
import type { Rich as RichText } from '../../data/rich';
import Rich from '../ui/Rich.astro';

interface Props {
  items: readonly { title?: string; text: RichText }[];
}

const { items } = Astro.props;
---
<ul class="feature-rows">
  {items.map((item) => (
    <li>
      {item.title && <h3>{item.title}</h3>}
      <p><Rich text={item.text} /></p>
    </li>
  ))}
</ul>

<style>
  li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-col);
    row-gap: var(--space-3);
    padding-block: var(--space-3) var(--space-6);
    border-top: var(--rule-mid) solid var(--color-line-strong);
  }

  h3 {
    grid-column: 1 / span 3;
    font-size: var(--text-principle);
    font-weight: var(--weight-poster);
    font-stretch: var(--stretch-narrow);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  p {
    grid-column: 4 / span 4;
    margin: 0;
  }

  @media (max-width: 60rem) {
    h3,
    p {
      grid-column: 1 / -1;
    }
  }
</style>
