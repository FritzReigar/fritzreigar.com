---
// Una fila por función o por punto (plan/spec-visual.md § 2.2, «Fichas»): el filete fuerte de 2 px
// arriba, el título en caja alta a --text-principle (1-3), el texto (4-7) y, si la lleva, su
// captura (8-12). Apiladas por debajo de 60rem. Con capturas, «Qué hace» de Snugtone (la última
// fila va sin ella); sin capturas, «Qué se hizo» de Artemisa (spec § 2.4) y los puntos de Snugport.
// Una fila sin título (los puntos de Snugport) lleva el texto en 1-7, sin dejar el hueco del título.
// El `sizes` es el de spec § 6.2.
import type { Rich as RichText } from '../../data/rich';
import type { ShotKey } from '../../data/shots';
import type { Lang } from '../../data/ui';
import Rich from '../ui/Rich.astro';
import Shot from '../ui/Shot.astro';

interface Props {
  items: readonly { title?: string; text: RichText; shot?: ShotKey }[];
  lang: Lang;
}

const { items, lang } = Astro.props;
---
<ul class="feature-rows">
  {items.map((item) => (
    <li class:list={{ 'feature-rows__untitled': !item.title }}>
      {item.title && <h3>{item.title}</h3>}
      <p><Rich text={item.text} /></p>
      {item.shot && <Shot shot={item.shot} lang={lang} sizes="(max-width: 60rem) 92vw, 515px" />}
    </li>
  ))}
</ul>

<style>
  li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-col);
    row-gap: var(--space-3);
    padding-block: var(--space-3) var(--space-6);
    border-top: var(--rule-mid) solid var(--color-line-strong);
  }

  h3 {
    grid-column: 1 / span 3;
    font-size: var(--text-principle);
    font-weight: var(--weight-poster);
    font-stretch: var(--stretch-narrow);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  p {
    grid-column: 4 / span 4;
    margin: 0;
  }

  .feature-rows__untitled p {
    grid-column: 1 / span 7;
  }

  li > :global(picture) {
    grid-column: 8 / span 5;
  }

  @media (max-width: 60rem) {
    h3,
    p,
    .feature-rows__untitled p,
    li > :global(picture) {
      grid-column: 1 / -1;
    }
  }
</style>
