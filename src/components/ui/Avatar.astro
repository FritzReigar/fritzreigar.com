---
// El avatar (plan/spec-visual.md § 2.2 y § 6.4): el dibujo vectorizado y aligerado de
// docs/lienzo/herramientas/avatar-ligero.svgfrag, en línea para que se trace con el CSS
// de la página (un <img> no deja). Cuatro capas: piel, camiseta, rayado de la barba y los 26
// trazos de línea, cada una con su clase y su token --color-avatar-* (el dibujo no cambia con
// el tema). El reposo es el dibujo acabado: los trazos, rellenos y sin línea. Llevan
// pathLength="1" y stroke-dasharray: 1 para que src/styles/motion.css los trace al cargar.
interface Props {
  alt: string;
  class?: string;
}

const { alt, class: className } = Astro.props;
