---
// Las etiquetas de tecnología, cada una con su filete fino (plan/spec-visual.md § 2.2). La usan
// los cierres de las fichas (CaseClosing, tanda 2.5).
interface Props {
  items: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---
<ul class:list={['stack-list', className]}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  li {
    padding: calc(var(--space-1) / 2) var(--space-2);
    border: var(--rule) solid var(--color-line);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
</style>
