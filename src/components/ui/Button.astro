---
// Botón o enlace con caja de 48 px y borde de 1 px, sin radio (plan/spec-visual.md § 2.2). El
// primario es cobalto y oscurece encima; el secundario, con borde de tinta, se invierte. Con href
// es un enlace; sin él, un <button>. El «↗» de los externos va en el texto (plan/contenido.md).
import type { HTMLAttributes } from 'astro/types';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  type?: HTMLAttributes<'button'>['type'];
  class?: string;
}

const { href, variant = 'secondary', external = false, type = 'submit', class: className } =
  Astro.props;
const classes = ['button', `button--${variant}`, className];
---
{href ? (
  <a class:list={classes} href={href} rel={external ? 'external' : undefined}><slot /></a>
) : (
  <button class:list={classes} type={type}><slot /></button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--height-button);
    padding: var(--space-2) var(--space-4);
    border: var(--rule) solid var(--color-line-strong);
    background: transparent;
    color: var(--color-text);
    font: var(--weight-bold) var(--text-s) / var(--leading-tight) var(--font);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-hover) var(--ease-out),
      color var(--duration-hover) var(--ease-out);
  }

  .button--secondary:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .button--primary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }
</style>
