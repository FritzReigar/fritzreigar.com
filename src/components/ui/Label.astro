---
// El rótulo pequeño, en caja normal y gris (plan/spec-visual.md § 2.2). Sobre celeste toma
// --color-on-sky-muted: lo pone el bloque celeste con --label-color.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<p class:list={['label', className]}><slot /></p>

<style>
  .label {
    margin: 0;
    color: var(--label-color, var(--color-text-muted));
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
</style>
