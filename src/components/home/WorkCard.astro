---
// La tarjeta normal de Trabajo (plan/spec-visual.md § 2.2, «Portada»): la captura (1-6) y el
// texto (8-12) sobre el fondo. Se pulsa entera (.tap-card). Hoy, Limpiezas Artemisa.
import { type CaseEntry, casePath } from '../../data/cases';
import type { Lang } from '../../data/ui';
import ArrowLink from '../ui/ArrowLink.astro';
import Label from '../ui/Label.astro';
import Shot from '../ui/Shot.astro';

interface Props {
  entry: CaseEntry;
  lang: Lang;
  linkText: string;
}

const { entry, lang, linkText } = Astro.props;
const { title, card } = entry.data;
---
<article class="work-card tap-card">
  <div class="work-card__media">
    <Shot shot={card.shots[0]} lang={lang} sizes="(max-width: 60rem) 92vw, 624px" />
  </div>
  <div class="work-card__text card-text">
    <Label>{card.label}</Label>
    <h3 class="card-title">{title}</h3>
    <p>{card.summary}</p>
    <p><ArrowLink href={casePath(entry, lang)}>{linkText}</ArrowLink></p>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-col);
    row-gap: var(--space-4);
    align-items: start;
  }

  .work-card__media {
    grid-column: 1 / span 6;
  }

  .work-card__text {
    grid-column: 8 / span 5;
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 60rem) {
    .work-card__media,
    .work-card__text {
      grid-column: 1 / -1;
    }
  }
</style>
