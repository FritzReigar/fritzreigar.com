---
// La trayectoria (plan/spec-visual.md § 2.2, «Portada»): una tabla de tres columnas (fechas en
// Archivo 75 % negrita a --text-l, puesto en negrita, dónde), con las filas separadas por un
// filete fino. A 45rem o menos, cada fila es una ficha de tres líneas y la cabecera queda solo
// para lectores de pantalla.
interface Props {
  headers: { dates: string; role: string; place: string };
  rows: readonly { dates: string; role: string; place: string }[];
}

const { headers, rows } = Astro.props;
---
<table class="career-table">
  <thead>
    <tr>
      <th scope="col">{headers.dates}</th>
      <th scope="col">{headers.role}</th>
      <th scope="col">{headers.place}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <td class="career-table__dates">{row.dates}</td>
        <td class="career-table__role">{row.role}</td>
        <td>{row.place}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .career-table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    padding: 0 var(--space-3) var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-align: left;
  }

  td {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-top: var(--rule) solid var(--color-line);
    vertical-align: top;
  }

  .career-table__dates {
    width: 13rem;
    font-size: var(--text-l);
    font-weight: var(--weight-poster);
    font-stretch: var(--stretch-narrow);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .career-table__role {
    font-weight: var(--weight-bold);
  }

  @media (max-width: 45rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    tr {
      display: grid;
      gap: var(--space-1);
      padding-block: var(--space-3);
      border-top: var(--rule) solid var(--color-line);
    }

    td,
    .career-table__dates {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
    }
  }
</style>
