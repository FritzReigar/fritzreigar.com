---
// El proyecto grande (plan/spec-visual.md § 2.2, «Portada»): el texto (1-4) y sus tres capturas
// (5-12: una entera arriba y dos debajo; a 35rem o menos, las tres en columna). Se pulsa entera
// (.tap-card). Hoy, Snugtone.
import { type CaseEntry, casePath } from '../../data/cases';
import type { Lang } from '../../data/ui';
import ArrowLink from '../ui/ArrowLink.astro';
import Label from '../ui/Label.astro';
import Shot from '../ui/Shot.astro';

interface Props {
  entry: CaseEntry;
  lang: Lang;
  linkText: string;
}

const { entry, lang, linkText } = Astro.props;
const { title, card } = entry.data;
const [main, ...small] = card.shots;
---
<article class="project-feature tap-card">
  <div class="project-feature__text card-text">
    <Label>{card.label}</Label>
    <h3 class="card-title">{title}</h3>
    <p>{card.summary}</p>
    <p><ArrowLink href={casePath(entry, lang)}>{linkText}</ArrowLink></p>
  </div>
  <div class="project-feature__shots">
    <Shot shot={main} lang={lang} sizes="(max-width: 60rem) 92vw, 843px" />
    {small.map((shot) => (
      <Shot shot={shot} lang={lang} sizes="(max-width: 35rem) 92vw, (max-width: 60rem) 45vw, 413px" />
    ))}
  </div>
</article>

<style>
  .project-feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-col);
    row-gap: var(--space-4);
    align-items: start;
  }

  .project-feature__text {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--space-3);
  }

  .project-feature__shots {
    grid-column: 5 / span 8;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .project-feature__shots > :global(picture:first-child) {
    grid-column: 1 / -1;
  }

  @media (max-width: 60rem) {
    .project-feature__text,
    .project-feature__shots {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 35rem) {
    .project-feature__shots {
      grid-template-columns: 1fr;
    }
  }
</style>
