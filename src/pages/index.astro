---
// La portada (plan/contenido.md § 1; plan/spec-visual.md § 2.3 y § 3.4): el texto sale de
// src/data/home.ts y las tarjetas de Trabajo y Proyectos, de la colección `cases` (la primera de
// cada sección es la grande). Pintada hasta «Todo el código público» (tanda 2.3); Cómo trabajo,
// Trayectoria y Contacto siguen sin estilo hasta la 2.4.
import HomeHero from '../components/heroes/HomeHero.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import ProjectFeature from '../components/home/ProjectFeature.astro';
import ProjectMini from '../components/home/ProjectMini.astro';
import ShotBands from '../components/home/ShotBands.astro';
import StudioBand from '../components/home/StudioBand.astro';
import WorkCard from '../components/home/WorkCard.astro';
import WorkFeature from '../components/home/WorkFeature.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Rich from '../components/ui/Rich.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { getCases } from '../data/cases';
import { home } from '../data/home';
import { EMAIL, FORM_ACTION, formText, ui } from '../data/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'es';
const text = home[lang];
const ids = ui[lang].sectionIds;
const [workFeature, ...workCards] = await getCases(lang, 'work');
const [projectFeature, ...projectCards] = await getCases(lang, 'projects');
const { mini } = text.projects;
---
<BaseLayout
  title={text.meta.title}
  description={text.meta.description}
  og={text.meta.og}
  jsonLd={text.jsonLd}
>
  <HomeHero
    name={text.hero.name}
    avatarAlt={text.hero.avatarAlt}
    lede={text.hero.lede}
    status={text.hero.status}
    actions={[
      { href: text.hero.studio.href, label: text.hero.studio.text, external: true },
      { href: `#${ids.contact}`, label: text.hero.contact },
    ]}
  />

  <StudioBand
    id="estudio"
    title={text.studio.title}
    text={text.studio.text}
    link={text.studio.link}
    shots={text.studio.shots}
    lang={lang}
  />

  <section class="section" id={ids.work} aria-labelledby={`${ids.work}-titulo`}>
    <div class="wrap home-work">
      <SectionTitle id={`${ids.work}-titulo`} text={text.work.title} />
      {workFeature && <WorkFeature entry={workFeature} lang={lang} linkText={text.work.cardLink} />}
      {workCards.map((entry) => <WorkCard entry={entry} lang={lang} linkText={text.work.cardLink} />)}
    </div>
    <ShotBands rows={text.bands} lang={lang} />
  </section>

  <section class="section" id={ids.projects} aria-labelledby={`${ids.projects}-titulo`}>
    <div class="wrap">
      <SectionTitle id={`${ids.projects}-titulo`} text={text.projects.title} />
      {projectFeature && <ProjectFeature entry={projectFeature} lang={lang} linkText={text.projects.cardLink} />}
      <div class="grid home-projects__row">
        {projectCards.map((entry) => (
          <ProjectCard entry={entry} lang={lang} linkText={text.projects.cardLink} class="home-projects__card" />
        ))}
        <ProjectMini title={mini.title} label={mini.label} text={mini.text} link={mini.link} shot={mini.shot} lang={lang} class="home-projects__mini" />
      </div>
      <p class="home-projects__more"><ArrowLink href={text.projects.more.href} external>{text.projects.more.text}</ArrowLink></p>
    </div>
  </section>

  <section class="section" aria-labelledby={ids.how}>
    <div class="wrap">
    <h2 id={ids.how}>{text.how.title}</h2>
    <ol>
      {text.how.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p><Rich text={item.text} /></p>
        </li>
      ))}
    </ol>
    </div>
  </section>

  <section class="section" aria-labelledby={ids.career}>
    <div class="wrap">
    <h2 id={ids.career}>{text.career.title}</h2>
    <table>
      <thead>
        <tr>
          <th scope="col">{text.career.headers.dates}</th>
          <th scope="col">{text.career.headers.role}</th>
          <th scope="col">{text.career.headers.place}</th>
        </tr>
      </thead>
      <tbody>
        {text.career.rows.map((row) => (
          <tr>
            <td>{row.dates}</td>
            <td>{row.role}</td>
            <td>{row.place}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h3>{text.career.education.title}</h3>
    <ul>
      {text.career.education.items.map((item) => <li>{item}</li>)}
    </ul>
    <h3>{text.career.languages.title}</h3>
    <p>{text.career.languages.text}</p>
    <p><a href={ui.es.cvHref}>{text.career.cv}</a></p>
    </div>
  </section>

  <section class="section section--last" aria-labelledby={ids.contact}>
    <div class="wrap">
    <h2 id={ids.contact}>{text.contact.title}</h2>
    <p><Rich text={text.contact.lede} /></p>
    <p>{text.contact.direct}<a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <form action={FORM_ACTION} method="POST">
      <input type="hidden" name="_subject" value={formText.subject}>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden>
      <p>
        <label for="contacto-nombre">{formText.name}</label>
        <input id="contacto-nombre" type="text" name="name" autocomplete="name" placeholder={formText.namePlaceholder} required>
      </p>
      <p>
        <label for="contacto-email">{formText.email}</label>
        <input id="contacto-email" type="email" name="email" autocomplete="email" placeholder={formText.emailPlaceholder} required>
      </p>
      <p>
        <label for="contacto-mensaje">{formText.message}</label>
        <textarea id="contacto-mensaje" name="message" rows="5" placeholder={formText.messagePlaceholder} required></textarea>
      </p>
      <p><button type="submit">{formText.submit}</button></p>
    </form>
    <p><a href={ui.es.cvHref}>{text.contact.cv}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-work {
    display: grid;
    row-gap: var(--space-block);
  }

  .home-work > :global(.section-title) {
    margin-bottom: 0;
  }

  .home-projects__row {
    row-gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-block-l);
  }

  .home-projects__row > :global(.home-projects__card) {
    grid-column: 1 / span 8;
  }

  .home-projects__row > :global(.home-projects__mini) {
    grid-column: 9 / span 4;
  }

  .home-projects__more {
    margin-top: var(--space-5);
  }

  @media (max-width: 60rem) {
    .home-projects__row > :global(.home-projects__card),
    .home-projects__row > :global(.home-projects__mini) {
      grid-column: 1 / -1;
    }
  }
</style>
