---
// La portada (plan/contenido.md § 1; plan/spec-visual.md § 2.3 y § 3.4): el texto sale de
// src/data/home.ts y las tarjetas de Trabajo y Proyectos, de la colección `cases` (la primera de
// cada sección es la grande). Entera desde la tanda 2.4.
import HomeHero from '../components/heroes/HomeHero.astro';
import CareerExtra from '../components/home/CareerExtra.astro';
import CareerTable from '../components/home/CareerTable.astro';
import ContactSection from '../components/home/ContactSection.astro';
import PrincipleList from '../components/home/PrincipleList.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import ProjectFeature from '../components/home/ProjectFeature.astro';
import ProjectMini from '../components/home/ProjectMini.astro';
import ShotBands from '../components/home/ShotBands.astro';
import StudioBand from '../components/home/StudioBand.astro';
import WorkCard from '../components/home/WorkCard.astro';
import WorkFeature from '../components/home/WorkFeature.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { getCases } from '../data/cases';
import { home } from '../data/home';
import { ui } from '../data/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'es';
const text = home[lang];
const ids = ui[lang].sectionIds;
const [workFeature, ...workCards] = await getCases(lang, 'work');
const [projectFeature, ...projectCards] = await getCases(lang, 'projects');
const { mini } = text.projects;
---
<BaseLayout
  title={text.meta.title}
  description={text.meta.description}
  og={text.meta.og}
  jsonLd={text.jsonLd}
>
  <HomeHero
    name={text.hero.name}
    avatarAlt={text.hero.avatarAlt}
    lede={text.hero.lede}
    status={text.hero.status}
    actions={[
      { href: text.hero.studio.href, label: text.hero.studio.text, external: true },
      { href: `#${ids.contact}`, label: text.hero.contact },
    ]}
  />

  <StudioBand
    id="estudio"
    title={text.studio.title}
    text={text.studio.text}
    link={text.studio.link}
    shots={text.studio.shots}
    lang={lang}
  />

  <section class="section" id={ids.work} aria-labelledby={`${ids.work}-titulo`}>
    <div class="wrap home-work">
      <SectionTitle id={`${ids.work}-titulo`} text={text.work.title} />
      {workFeature && <WorkFeature entry={workFeature} lang={lang} linkText={text.work.cardLink} />}
      {workCards.map((entry) => <WorkCard entry={entry} lang={lang} linkText={text.work.cardLink} />)}
    </div>
    <ShotBands rows={text.bands} lang={lang} />
  </section>

  <section class="section" id={ids.projects} aria-labelledby={`${ids.projects}-titulo`}>
    <div class="wrap">
      <SectionTitle id={`${ids.projects}-titulo`} text={text.projects.title} />
      {projectFeature && <ProjectFeature entry={projectFeature} lang={lang} linkText={text.projects.cardLink} />}
      <div class="grid home-projects__row">
        {projectCards.map((entry) => (
          <ProjectCard entry={entry} lang={lang} linkText={text.projects.cardLink} class="home-projects__card" />
        ))}
        <ProjectMini title={mini.title} label={mini.label} text={mini.text} link={mini.link} shot={mini.shot} lang={lang} class="home-projects__mini" />
      </div>
      <p class="home-projects__more"><ArrowLink href={text.projects.more.href} external>{text.projects.more.text}</ArrowLink></p>
    </div>
  </section>

  <section class="section" id={ids.how} aria-labelledby={`${ids.how}-titulo`}>
    <div class="wrap">
      <SectionTitle id={`${ids.how}-titulo`} text={text.how.title} />
      <PrincipleList items={text.how.items} />
    </div>
  </section>

  <section class="section" id={ids.career} aria-labelledby={`${ids.career}-titulo`}>
    <div class="wrap">
      <SectionTitle id={`${ids.career}-titulo`} text={text.career.title} />
      <CareerTable headers={text.career.headers} rows={text.career.rows} />
      <CareerExtra
        education={text.career.education}
        languages={text.career.languages}
        cv={{ text: text.career.cv, href: ui[lang].cvHref }}
      />
    </div>
  </section>

  <ContactSection
    id={ids.contact}
    title={text.contact.title}
    lede={text.contact.lede}
    direct={text.contact.direct}
    cv={{ text: text.contact.cv, href: ui[lang].cvHref }}
  />
</BaseLayout>

<style>
  .home-work {
    display: grid;
    row-gap: var(--space-block);
  }

  .home-work > :global(.section-title) {
    margin-bottom: 0;
  }

  .home-projects__row {
    row-gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-block-l);
  }

  .home-projects__row > :global(.home-projects__card) {
    grid-column: 1 / span 8;
  }

  .home-projects__row > :global(.home-projects__mini) {
    grid-column: 9 / span 4;
  }

  .home-projects__more {
    margin-top: var(--space-5);
  }

  @media (max-width: 60rem) {
    .home-projects__row > :global(.home-projects__card),
    .home-projects__row > :global(.home-projects__mini) {
      grid-column: 1 / -1;
    }
  }
</style>
