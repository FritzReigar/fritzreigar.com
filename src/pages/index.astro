---
// La portada (plan/contenido.md § 1), sin estilo: el texto sale de src/data/home.ts y las
// tarjetas de Trabajo y Proyectos, de la colección `cases`. Los componentes que la pintan
// (HomeHero, StudioBand, WorkFeature…) son de las tandas 2.3 y 2.4 (plan/spec-visual.md § 2.3).
import Rich from '../components/ui/Rich.astro';
import { casePath, getCases } from '../data/cases';
import { home } from '../data/home';
import { EMAIL, FORM_ACTION, formText, ui } from '../data/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const text = home.es;
const ids = ui.es.sectionIds;
const work = await getCases('es', 'work');
const projects = await getCases('es', 'projects');
---
<BaseLayout
  title={text.meta.title}
  description={text.meta.description}
  og={text.meta.og}
  jsonLd={text.jsonLd}
>
  <section aria-labelledby="nombre">
    <h1 id="nombre">{text.hero.name}</h1>
    <p>{text.hero.lede}</p>
    <p>{text.hero.status}</p>
    <p>
      <a href={text.hero.studio.href}>{text.hero.studio.text}</a>
      ·
      <a href={`#${ids.contact}`}>{text.hero.contact}</a>
    </p>
  </section>

  <section aria-labelledby="estudio">
    <h2 id="estudio">{text.studio.title}</h2>
    <p>{text.studio.text}</p>
    <p><a href={text.studio.link.href}>{text.studio.link.text}</a></p>
  </section>

  <section aria-labelledby={ids.work}>
    <h2 id={ids.work}>{text.work.title}</h2>
    {work.map((entry) => (
      <article>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.card.label}</p>
        <p>{entry.data.card.summary}</p>
        <p><a href={casePath(entry, 'es')}>{text.work.cardLink}</a></p>
      </article>
    ))}
  </section>

  <section aria-labelledby={ids.projects}>
    <h2 id={ids.projects}>{text.projects.title}</h2>
    {projects.map((entry) => (
      <article>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.card.label}</p>
        <p>{entry.data.card.summary}</p>
        <p><a href={casePath(entry, 'es')}>{text.projects.cardLink}</a></p>
      </article>
    ))}
    <article>
      <h3>{text.projects.mini.title}</h3>
      <p>{text.projects.mini.label}</p>
      <p>{text.projects.mini.text}</p>
      <p><a href={text.projects.mini.link.href}>{text.projects.mini.link.text}</a></p>
    </article>
    <p><a href={text.projects.more.href}>{text.projects.more.text}</a></p>
  </section>

  <section aria-labelledby={ids.how}>
    <h2 id={ids.how}>{text.how.title}</h2>
    <ol>
      {text.how.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p><Rich text={item.text} /></p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby={ids.career}>
    <h2 id={ids.career}>{text.career.title}</h2>
    <table>
      <thead>
        <tr>
          <th scope="col">{text.career.headers.dates}</th>
          <th scope="col">{text.career.headers.role}</th>
          <th scope="col">{text.career.headers.place}</th>
        </tr>
      </thead>
      <tbody>
        {text.career.rows.map((row) => (
          <tr>
            <td>{row.dates}</td>
            <td>{row.role}</td>
            <td>{row.place}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h3>{text.career.education.title}</h3>
    <ul>
      {text.career.education.items.map((item) => <li>{item}</li>)}
    </ul>
    <h3>{text.career.languages.title}</h3>
    <p>{text.career.languages.text}</p>
    <p><a href={ui.es.cvHref}>{text.career.cv}</a></p>
  </section>

  <section aria-labelledby={ids.contact}>
    <h2 id={ids.contact}>{text.contact.title}</h2>
    <p><Rich text={text.contact.lede} /></p>
    <p>{text.contact.direct}<a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <form action={FORM_ACTION} method="POST">
      <input type="hidden" name="_subject" value={formText.subject}>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden>
      <p>
        <label for="contacto-nombre">{formText.name}</label>
        <input id="contacto-nombre" type="text" name="name" autocomplete="name" placeholder={formText.namePlaceholder} required>
      </p>
      <p>
        <label for="contacto-email">{formText.email}</label>
        <input id="contacto-email" type="email" name="email" autocomplete="email" placeholder={formText.emailPlaceholder} required>
      </p>
      <p>
        <label for="contacto-mensaje">{formText.message}</label>
        <textarea id="contacto-mensaje" name="message" rows="5" placeholder={formText.messagePlaceholder} required></textarea>
      </p>
      <p><button type="submit">{formText.submit}</button></p>
    </form>
    <p><a href={ui.es.cvHref}>{text.contact.cv}</a></p>
  </section>
</BaseLayout>
