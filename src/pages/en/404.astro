---
// El 404 de /en/. Mientras el inglés no exista (en.live en false, src/data/routes.ts), solo dice
// que la página no existe y lleva a la portada española. Su texto es de la fase 2.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pathFor } from '../../data/routes';
---
<BaseLayout title="Page not found · Fritz Reigar" noindex>
  <p>Error 404</p>
  <h1>This page does not exist</h1>
  <p><a href={pathFor('home', 'en')}>Go to the home page</a></p>
</BaseLayout>
