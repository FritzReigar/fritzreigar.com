---
// La ficha de Limpiezas Artemisa (plan/contenido.md § 3), sin estilo. La vitrina con sus capturas
// entra en la fase 2 (CaseShowcase, plan/spec-visual.md).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectionHref } from '../../data/routes';

const done = [
  {
    title: 'Una web estática, sin framework ni dependencias',
    text: ', en Cloudflare Pages y desplegada desde GitHub en cada push: portada, una página por servicio (seis), blog y las páginas legales, más una página de error propia.',
  },
  {
    title: 'SEO local:',
    text: ' una página por servicio para que Google enseñe la que toca a quien busca «limpieza de comunidades» y no la portada; datos estructurados (LocalBusiness, Service, BreadcrumbList, BlogPosting); sitemap y alta en Search Console.',
  },
  {
    title: 'El formulario, sin terceros en el navegador:',
    text: ' una Pages Function que envía con Resend y que solo confirma el envío si responde el servidor, con validación y filtros contra el spam en el servidor y sin captcha. Al lado, WhatsApp y una barra fija de llamar y escribir en el móvil.',
  },
  {
    title: 'CSP estricta y ni una cookie:',
    text: ' cabeceras de seguridad (CSP, HSTS, X-Frame-Options) y analítica sin cookies, así que tampoco banner: pedir permiso para algo que no ocurre sería incorrecto además de molesto.',
  },
  {
    title: 'Los dominios, ordenados:',
    text: ' uno principal y el resto llevando a él con su certificado, sin mover el dominio ni el correo de su proveedor.',
  },
  {
    title: 'Google Business Profile:',
    text: ' auditoría inicial, descripción reescrita, catálogo de servicios completo, zonas de servicio ampliadas y publicaciones que enlazan a la web.',
  },
  {
    title: 'Después:',
    text: ' mantenimiento mensual de la ficha, un artículo al mes en el blog, actualizaciones y copias.',
  },
];

const stack = [
  'HTML',
  'CSS',
  'JavaScript',
  'Cloudflare Pages',
  'Pages Functions',
  'Resend',
  'JSON-LD',
  'Cloudflare Web Analytics',
  'Search Console',
  'Google Business Profile',
];
---
<BaseLayout
  title="Limpiezas Artemisa · Trabajo · Fritz Reigar"
  description="Web estática a medida para una empresa de limpieza de Valencia: SEO local, sin cookies, CSP estricta y Lighthouse móvil de 95-96 en rendimiento y 100 en lo demás."
  og={{
    title: 'Limpiezas Artemisa: web nueva y ficha de Google',
    description: 'Una página por servicio, sin una cookie y con la nota de Lighthouse medida.',
  }}
  current="work"
>
  <article>
    <header>
      <p><a href={sectionHref('work', 'es')}>Trabajo</a> · Cliente · Web nueva · Entregada en septiembre de 2026 · En mantenimiento</p>
      <h1>Limpiezas Artemisa</h1>
      <p>
        Empresa de limpieza de Valencia —hogares, oficinas, comunidades, cristales, garajes y fin
        de obra— con buenas reseñas en Google y sin web propia. Web nueva, a medida, y su ficha de
        Google puesta a punto.
      </p>
      <p>
        <a href="https://www.limpiezasartemisa.com/">Ver la web ↗</a>
        ·
        <a href="https://estudioreigar.com/casos/limpiezas-artemisa">El caso contado para negocios, en estudioreigar.com ↗</a>
      </p>
    </header>

    <section aria-labelledby="de-donde-se-partia">
      <h2 id="de-donde-se-partia">De dónde se partía</h2>
      <p>
        Sin web propia, varios dominios comprados y ninguno enseñando nada, y la ficha de Google sin
        fotos ordenadas ni categorías bien puestas.
      </p>
    </section>

    <section aria-labelledby="que-se-hizo">
      <h2 id="que-se-hizo">Qué se hizo</h2>
      <ul>
        {done.map((item) => (
          <li><strong>{item.title}</strong>{item.text}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="medido">
      <h2 id="medido">Medido</h2>
      <p>
        Lighthouse en el móvil, en la portada y en dos páginas de servicio: <strong>rendimiento
        95-96, y 100 en accesibilidad, buenas prácticas y SEO</strong>.
      </p>
    </section>

    <section aria-labelledby="de-quien-es">
      <h2 id="de-quien-es">De quién es cada cosa</h2>
      <p>
        Del cliente: los dominios, el alojamiento y el correo, la ficha de Google y Search Console.
        Yo soy el gestor técnico, no el dueño.
      </p>
    </section>

    <section aria-labelledby="con-que">
      <h2 id="con-que">Con qué</h2>
      <ul>
        {stack.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby="lo-que-no-se-ensena">
      <h2 id="lo-que-no-se-ensena">Lo que no se enseña</h2>
      <p>
        Lo que costó, y los números de su ficha de Google: vistas, llamadas y búsquedas son datos de
        su negocio. Lo que se mide aquí es la web.
      </p>
    </section>
  </article>
</BaseLayout>
