---
// La ficha de Limpiezas Artemisa (plan/contenido.md § 3), sin estilo: el texto sale de
// src/content/cases/es/limpiezas-artemisa.json. La tanda 2.5 la pinta con CaseHero, CaseShowcase (con sus
// capturas) y CaseBody (plan/spec-visual.md § 2.2).
import CaseBody from '../../components/case/CaseBody.astro';
import { getCase } from '../../data/cases';
import { sectionHref } from '../../data/routes';
import { ui } from '../../data/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { data } = await getCase('work-artemisa', 'es');
---
<BaseLayout
  title={data.meta.title}
  description={data.meta.description}
  og={data.meta.og}
  current="work"
>
  <article>
    <header>
      <p><a href={sectionHref('work', 'es')}>{ui.es.caseSection.work}</a> · {data.kicker}</p>
      <h1>{data.title}</h1>
      <p>{data.lede}</p>
      <p>
        <a href={data.primary.href}>{data.primary.text}</a>
        {data.secondary && (
          <>
            · <a href={data.secondary.href}>{data.secondary.text}</a>
          </>
        )}
      </p>
    </header>
    {data.showcase.caption && <p><small>{data.showcase.caption}</small></p>}

    <CaseBody body={data.body} lang="es" />
  </article>
</BaseLayout>
