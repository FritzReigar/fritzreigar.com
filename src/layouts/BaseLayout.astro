---
// El molde de todas las páginas: el <head> (con la hoja única y la precarga de la fuente), el
// enlace de salto, la cabecera, el pie y el único script. Cada página pone su contenido, que entra
// por <slot /> dentro de <main>. El marco es de plan/spec-visual.md § 2.2.
// El idioma no es una prop: lo da la carpeta (src/pages/en/ es inglés). Si la página tiene gemela
// viva en el otro idioma (src/data/routes.ts), lleva el hreflang de las dos y el enlace de idioma
// (SiteHeader y MobileMenu, con LangLink). El Open Graph sale de routes.ts: el texto de su `og` y
// la imagen que pinta src/pages/og/[lang]/[key].png.ts (tanda 2.10).
import '../styles/tokens.css';
import '../styles/global.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SkipLink from '../components/site/SkipLink.astro';
import { OG_IMAGE, ogImagePathOf, routeOf, twinsOf } from '../data/routes';
import { langOf, type NavSection } from '../data/ui';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: unknown;
  current?: NavSection;
}

const { title, description, noindex = false, jsonLd, current: section } = Astro.props;

const lang = langOf(Astro.currentLocale);

// La URL pública sin .html (con format: 'preserve' el pathname la lleva).
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;

// hreflang recíproco solo entre indexables con gemela viva; x-default, al español (decisión 2).
const current = routeOf(Astro.url.pathname);
const twins = !noindex && current ? twinsOf(current.route) : undefined;
const hreflang = twins && [
  { hreflang: 'es', href: new URL(twins.es, Astro.site).href },
  { hreflang: 'en', href: new URL(twins.en, Astro.site).href },
  { hreflang: 'x-default', href: new URL(twins.es, Astro.site).href },
];

const og = !noindex && current ? current.route.og?.[lang] : undefined;
const ogImagePath = current && ogImagePathOf(current.route, lang);
const ogImage = og && ogImagePath ? new URL(ogImagePath, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
  {description && <meta name="description" content={description}>}
  {noindex && <meta name="robots" content="noindex">}
  {!noindex && <link rel="canonical" href={canonical}>}
  {hreflang && hreflang.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href}>)}
  <link rel="icon" href="/assets/img/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/assets/img/site.webmanifest">
  {og && ogImage && (
    <>
      <meta property="og:title" content={og.title}>
      <meta property="og:description" content={og.description}>
      <meta property="og:type" content="website">
      <meta property="og:url" content={canonical}>
      <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'}>
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:type" content="image/png">
      <meta property="og:image:width" content={String(OG_IMAGE.width)}>
      <meta property="og:image:height" content={String(OG_IMAGE.height)}>
      <meta property="og:image:alt" content={og.title}>
      <meta name="twitter:card" content="summary_large_image">
    </>
  )}
  {jsonLd !== undefined && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body>
  <SkipLink target="contenido" />
  <SiteHeader current={section} />

  <main id="contenido" tabindex="-1">
    <slot />
  </main>

  <SiteFooter />

  {/* El único script de la web (decisión 9): Astro lo empaqueta en /_astro/ y lo carga como módulo
      externo. Ningún componente lleva <script>. */}
  <script>import '../scripts/main.ts';</script>
</body>
</html>
